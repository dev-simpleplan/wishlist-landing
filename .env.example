VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
CONTACT_RECIPIENT_EMAIL=owner@example.com
VITE_STRAPI_URL=https://your-strapi-instance
# Optional for private read access. Leave empty if blog content is public.
VITE_STRAPI_API_TOKEN=
# Optional: custom API/webhook endpoint to receive contact form JSON.
# If set, this is used instead of FormSubmit in /api/contact.
CONTACT_FORM_ENDPOINT=
